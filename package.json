{
  "name": "ticket-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "LOCAL_DB_TESTS=1 DATABASE_DRIVER=pg DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/main} vitest run src/tests/local-db",
    "test:db:neon": "LOCAL_DB_TESTS=1 DATABASE_DRIVER=neon NEON_PROXY_HOST=${NEON_PROXY_HOST:-localhost:4444} DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@db.localtest.me:5432/main} vitest run src/tests/local-db",
    "kit:dev": "DATABASE_URL=${KIT_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/main} BETTER_AUTH_URL=http://localhost:5173 NEXT_PUBLIC_APP_URL=http://localhost:5173 vite dev",
    "kit:build": "vite build",
    "kit:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.svelte.json --threshold error",
    "kit:gen-actions": "node scripts/gen-remote-actions.mjs"
  },
  "dependencies": {
