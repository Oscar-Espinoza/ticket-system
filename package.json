{
  "name": "ticket-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:mcp-ui",
    "dev": "vite dev",
    "predev:local": "npm run build:mcp-ui",
    "dev:local": "DATABASE_URL=${LOCAL_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/main} BETTER_AUTH_URL=http://localhost:3000 PUBLIC_APP_URL=http://localhost:3000 vite dev",
    "build:mcp-ui": "svelte-kit sync && vite build -c vite.mcp-ui.config.ts",
    "prebuild": "npm run build:mcp-ui",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "LOCAL_DB_TESTS=1 DATABASE_DRIVER=pg DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/main} vitest run src/tests/local-db/ src/tests/mcp/",
    "test:db:neon": "LOCAL_DB_TESTS=1 DATABASE_DRIVER=neon NEON_PROXY_HOST=${NEON_PROXY_HOST:-localhost:4444} DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@db.localtest.me:5432/main} vitest run --testTimeout 120000 --hookTimeout 120000 src/tests/local-db/ src/tests/mcp/",
    "db:migrate": "node scripts/migrate.mjs",
    "gen:actions": "node scripts/gen-remote-actions.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.6.33",
    "@better-auth/oauth-provider": "1.6.33",
    "@better-auth/scim": "1.6.33",
    "@better-auth/sso": "1.6.33",
    "@better-fetch/fetch": "1.3.1",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/svelte": "^0.5.3",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.17.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^0.10.4",
    "@octokit/rest": "^22.0.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-floating-menu": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@vercel/functions": "^3.10.6",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.33",
    "better-call": "1.4.0",
    "bits-ui": "^2.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1",
    "mode-watcher": "^1.1.0",
    "pg": "^8.23.1",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-sonner": "^1.2.3",
    "svelte-tiptap": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "kysely": "^0.28.17",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.1",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "pg-connection-string": "^2.14.1",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "better-auth": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
