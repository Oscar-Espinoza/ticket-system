# ─────────────────────────────────────────────────────────────────────────────
# Environment variable template — Linear-Clone Ticket System
#
# Copy to .env.local and fill in real values:   cp env.template .env.local
# .env.local is gitignored — NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required NOW (Wave 1 — apply the database migration) ─────────────────────

# Neon Postgres connection string.
#   Neon Console -> your Project -> Connection Details -> connection string.
#   MUST end with ?sslmode=require. Used by both Drizzle drivers and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Better Auth signing secret (signs session cookies/tokens).
#   Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Base URL Better Auth runs at, no trailing slash. Local dev = http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Public app URL exposed to the browser (used by the Better Auth client).
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Required for Wave 3 (GitHub OAuth sign-in) ───────────────────────────────
# Safe to fill in now. From github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret


# ── Optional (email notifications + invitations) ─────────────────────────────
# Without these, emails are logged to the server console instead of sent.
#   Resend (free tier): resend.com -> API Keys. EMAIL_FROM must use a verified domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Tickets <tickets@your-domain.com>"


# ── Optional (GitHub PR automation in local dev) ─────────────────────────────
# Public base URL GitHub delivers webhooks to, no trailing slash. Defaults to
# NEXT_PUBLIC_APP_URL; set it to a tunnel (ngrok, cloudflared) when developing
# on localhost, then register the webhook again in Settings → GitHub.
# GITHUB_WEBHOOK_BASE_URL=https://your-tunnel.example.com


# ── Round 2 (optional — every feature degrades gracefully when unset) ────────

# Daily cron (/api/cron/daily). Vercel sends it as a Bearer token automatically.
# CRON_SECRET=replace-with-openssl-rand-hex-32

# Web push notifications. Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Slack app (Asks + per-user notifications). From api.slack.com/apps → your app.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# Extra origins Better Auth trusts (comma-separated) — needed for an SSO identity
# provider on a private/localhost address, e.g. a local Keycloak.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080
