# Copy to .env next to docker-compose.yml (docker compose reads it automatically).

# Public URL people open (no trailing slash). Baked into the browser bundle:
# rebuild (docker compose up -d --build) after changing it.
APP_URL=http://localhost:3000
APP_PORT=3000

POSTGRES_USER=tickets
POSTGRES_DB=tickets
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Daily jobs (digests, SLAs, recurring issues, webhook retries) run inside the
# app at this hour, UTC. Default 8.
CRON_HOUR_UTC=
# Only if you also want to trigger them from outside: GET /api/cron/daily with
# "Authorization: Bearer <CRON_SECRET>". openssl rand -hex 32
CRON_SECRET=

# Optional — each feature switches off cleanly when unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_WEBHOOK_BASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
# true = refuse password sign-in until the email is verified. Needs
# RESEND_API_KEY + EMAIL_FROM (ignored without them). Default off.
REQUIRE_EMAIL_VERIFICATION=
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
# true = webhooks / GitLab / Sentry may target private-network hosts (an internal
# GitLab on 10.x). Leave empty unless you trust everyone who can configure them.
ALLOW_PRIVATE_OUTGOING_URLS=
