    {
      "declarations": [
        "input count",
        "input names",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "added label {names}",
        "countPlural=other": "added labels {names}"
      }
    }
  ],
